    "name": "Tasker4u",
    "tasks": [
      {
        "id": 1793726988542,
        "text": "Que si sales de una carpeta con tareas y tenías el filtro de pendientes activo, que al volver a entrar lo sigas teniendo activo (persistencia)",
        "done": false,
        "dueDate": null,
        "createdAt": "2026-11-03T17:29:48.542Z",
        "completedAt": null
      },
      {
        "id": 1793726939814,
        "text": "Que se puedan ordenar visualmente como tú quieras las tareas y carpetas manteniendo y arrastrando",
        "done": false,
        "dueDate": null,
        "createdAt": "2026-11-03T17:28:59.814Z",
        "completedAt": null
      },
      {
        "id": 1793726876651,
        "text": "Que al editar el nombre de una tarea te salga el nombre que tenía en un principio, y no tengas que escribirlo tú otra vez entero",
        "done": false,
        "dueDate": null,
        "createdAt": "2026-11-03T17:27:56.651Z",
        "completedAt": null
      },
      {
        "id": 1792593123555,
        "text": "Poder crear carpeta en un nivel de tareas  indicando el nombre de la carpeta a la que quieres que mS tareas de ese nivel se muevan",
